{
  "id": "com.mspa.httpcontroller",
  "version": "0.1.9",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "brandColor": "#2E6F95",
  "name": {
    "en": "MSpa Smart Restore"
  },
  "author": {
    "name": "MSpa Community",
    "email": "maintainer@example.com"
  },
  "description": {
    "en": "Keep your MSpa warm and ready after power loss."
  },
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "category": [
    "climate"
  ],
  "permissions": [],
  "flow": {
    "actions": [
      {
        "id": "mspa_restore",
        "title": {
          "en": "Restore MSpa desired mode"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=mspa_http"
          }
        ]
      },
      {
        "id": "mspa_test_connection",
        "title": {
          "en": "Test MSpa connection"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=mspa_http"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "mspa_http",
      "name": {
        "en": "MSpa Spa Controller"
      },
      "class": "heater",
      "images": {
        "small": "/drivers/mspa_http/assets/images/small.png",
        "large": "/drivers/mspa_http/assets/images/large.png",
        "xlarge": "/drivers/mspa_http/assets/images/xlarge.png"
      },
      "capabilities": [
        "onoff",
        "measure_temperature",
        "target_temperature",
        "alarm_generic",
        "mspa_filter",
        "mspa_bubbles",
        "mspa_auto_restore",
        "mspa_bath_status"
      ],
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          },
          "options": {
            "singular": true
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "settings": [
        {
          "id": "api_host",
          "type": "text",
          "label": {
            "en": "MSpa controller host (IP:port or DNS:port)"
          },
          "value": "192.168.1.50:8080",
          "hint": {
            "en": "Example: 192.168.1.123:8080. If auth field fails, use 192.168.1.123:8080|your-auth-key"
          }
        },
        {
          "id": "auth_key",
          "type": "text",
          "label": {
            "en": "API auth key"
          },
          "value": "",
          "hint": {
            "en": "Must match the token configured on ESP/simulator (stored locally on Homey)"
          }
        }
      ]
    }
  ],
  "capabilities": {
    "mspa_filter": {
      "type": "boolean",
      "title": {
        "en": "Filter"
      },
      "uiComponent": "toggle",
      "getable": true,
      "setable": true
    },
    "mspa_bubbles": {
      "type": "boolean",
      "title": {
        "en": "Bubbles"
      },
      "uiComponent": "toggle",
      "getable": true,
      "setable": true
    },
    "mspa_auto_restore": {
      "type": "boolean",
      "title": {
        "en": "Auto Restore"
      },
      "uiComponent": "toggle",
      "getable": true,
      "setable": true
    },
    "mspa_bath_status": {
      "type": "string",
      "title": {
        "en": "Bath Status"
      },
      "uiComponent": "sensor",
      "getable": true,
      "setable": false
    }
  }
}
